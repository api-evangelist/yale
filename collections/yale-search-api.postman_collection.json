      "item": [
        {
          "id": "f70c67e7-de00-4081-ba2a-072c57a1ddfc",
          "name": "Search a scope",
          "request": {
            "name": "Search a scope",
            "description": {
              "content": "Executes a query within a scope and returns a Linked Art OrderedCollectionPage of matching results in JSON-LD. The query may be expressed in LUX JSON Grammar or LUX String Grammar.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "search",
                ":scope"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Search criteria in LUX JSON Grammar or String Grammar."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "1-based page number."
                },
                {
                  "disabled": false,
                  "key": "pageLength",
                  "value": "<integer>",
                  "description": "Number of results per page."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort specification."
                },
                {
                  "disabled": false,
                  "key": "filterResults",
                  "value": "<boolean>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "scope",
                  "description": "(Required) The discovery scope to query. LUX scopes map to the major Linked Art entity categories."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
